# Apenas desenvolvimento local. O arquivo .env real não deve ser versionado.
MIGRATION_USER=srm
MIGRATION_PASSWORD=local-migration-password
DATABASE_USER=srm_app
DATABASE_PASSWORD=local-runtime-password
POSTGRES_PORT=5432

# Backend em desenvolvimento: exporte antes de iniciar a aplicação.
DATABASE_URL=jdbc:postgresql://localhost:5432/srm
APP_USERNAME=operator
APP_PASSWORD=local-operator-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-admin-password
# Apenas HTTP local; use true quando servido por HTTPS.
COOKIE_SECURE=false
PRICING_BASE_RATE=0.0100
FX_PROVIDER_URL=http://localhost:8090/rate
FX_MOCK_RATE=5.4321
FX_MOCK_PORT=8090

# Portas da orquestração completa (somente loopback).
BACKEND_PORT=8080
FRONTEND_PORT=4200
